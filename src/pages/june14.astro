---
import Layout from '../layouts/Layout.astro';
---
<Layout title="June 14 Banner Action" description="Join Indivisible Tahoe Truckee on June 14 at the Truckee Way Overpass to stand against Forest Service cuts and glyphosate spraying.">

  <!-- Nav -->
  <nav class="bg-navy-deep border-b border-white/10 sticky top-0 z-50">
    <div class="max-w-5xl mx-auto px-6 flex items-center justify-between h-16">
      <a href="/" class="flex flex-col leading-none">
        <span class="text-xs font-bold uppercase tracking-widest text-sky-bright">Tahoe Truckee</span>
        <span class="text-white font-black text-base tracking-wide uppercase">Indivisible</span>
      </a>
      <a href="/#join" class="bg-sky text-white text-sm font-bold px-5 py-2 rounded-lg hover:opacity-90 transition-opacity">Join Us</a>
    </div>
  </nav>

  <!-- Flyer + Content -->
  <section class="bg-navy min-h-screen py-16">
    <div class="max-w-2xl mx-auto px-6 flex flex-col items-center">

      <!-- Flyer -->
      <img
        src="/images/banner-action-june14-truckee-overpass.jpg"
        alt="Banner action flyer: Sunday June 14, 2026, 11am–12pm, Truckee Way Overpass — No Glyphosate, Save the Forest Service"
        class="w-full max-w-md rounded-2xl shadow-2xl mb-12"
      />

      <!-- Blurb -->
      <div class="w-full space-y-6 text-center">
        <h1 class="text-3xl md:text-4xl font-black text-white leading-tight">Stand Up for Our Forests</h1>
        <div class="w-12 h-1 bg-sky mx-auto rounded"></div>
        <p class="text-slate-300 leading-relaxed">
          The Trump administration is dismantling the U.S. Forest Service — firing thousands of workers, closing research stations, and authorizing glyphosate spraying in our national forests, including areas that feed into Tahoe's drinking water. We're showing up at the Truckee Way Overpass on June 14 to make our voices visible.
        </p>
        <p class="text-slate-300 leading-relaxed">
          This is a peaceful demonstration. Bring a sign, bring a friend, and show Congress that Tahoe-Truckee is paying attention.
        </p>
        <a href="https://forestservice.indivisibletahoetruckee.org" target="_blank" rel="noopener" class="inline-block mt-4 bg-sky text-white font-black text-base px-8 py-4 rounded-xl hover:opacity-90 transition-opacity">
          Learn More About Our Forest Service Campaign &rarr;
        </a>
      </div>

    </div>
  </section>

  <!-- Footer -->
  <footer class="bg-navy-deep border-t border-white/10 py-8">
    <div class="max-w-5xl mx-auto px-6 text-center">
      <p class="text-slate-500 text-sm">Indivisible Tahoe Truckee &nbsp;·&nbsp; <a href="mailto:IndivisibleTahoeTruckee@gmail.com" class="hover:text-white transition-colors">IndivisibleTahoeTruckee@gmail.com</a></p>
    </div>
  </footer>

</Layout>
