---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Events" description="Upcoming Indivisible Tahoe Truckee events — community actions, meetings, and social gatherings.">

  <!-- Nav -->
  <nav class="bg-navy-deep border-b border-white/10 sticky top-0 z-50">
    <div class="max-w-5xl mx-auto px-6 flex items-center justify-between h-16">
      <a href="/" class="flex flex-col leading-none">
        <span class="text-xs font-bold uppercase tracking-widest text-sky-bright">Tahoe Truckee</span>
        <span class="text-white font-black text-base tracking-wide uppercase">Indivisible</span>
      </a>
      <div class="flex items-center gap-6">
        <a href="https://forestservice.indivisibletahoetruckee.org" class="hidden md:block text-sm font-semibold text-slate-300 hover:text-white transition-colors">Forest Service Campaign</a>
        <a href="/events" class="hidden md:block text-sm font-semibold text-white transition-colors">Events</a>
        <a href="/#join" class="bg-sky text-white text-sm font-bold px-5 py-2 rounded-lg hover:opacity-90 transition-opacity">Join Us</a>
      </div>
    </div>
  </nav>

  <!-- Hero -->
  <section class="bg-navy py-20">
    <div class="max-w-5xl mx-auto px-6">
      <p class="section-label">Get Involved</p>
      <h1 class="text-5xl md:text-7xl font-black leading-none tracking-tight text-white mb-6">Upcoming<br />Events</h1>
      <div class="blue-rule"></div>
      <p class="text-xl text-slate-300 max-w-2xl leading-relaxed mt-6">Show up. Every person who comes out makes our voice louder.</p>
    </div>
  </section>

  <!-- Events List -->
  <section class="bg-navy-mid py-16">
    <div class="max-w-5xl mx-auto px-6 space-y-6">

      <!-- Saturday, October 17, 2026 — No Kings Rally: Vote Early -->
      <div class="card flex flex-col md:flex-row gap-8 items-start">
        <a href="https://www.mobilize.us/mobilize/event/1032152/" target="_blank" rel="noopener" class="w-full md:w-56 shrink-0">
          <img
            src="/images/vote-early-no-kings-rally-truckee.webp"
            alt="Vote Early, No Kings rally flyer — October 17, corners of Hwy 89 and Donner Pass Rd, Truckee CA, 3–4pm"
            class="w-full rounded-xl object-cover hover:opacity-90 transition-opacity"
          />
        </a>
        <div class="flex-1">
          <div class="flex items-center gap-3 mb-3 flex-wrap">
            <span class="bg-sky text-white text-xs font-black uppercase tracking-widest px-3 py-1 rounded-full">Upcoming</span>
            <span class="text-slate-400 text-sm font-semibold">Saturday, October 17, 2026</span>
          </div>
          <h2 class="text-white font-black text-2xl mb-1">No Kings Rally: Vote Early</h2>
          <p class="text-sky-bright font-bold mb-4">3:00pm – 4:00pm &nbsp;·&nbsp; Truckee, CA</p>
          <p class="text-slate-300 text-sm leading-relaxed mb-4">Join neighbors at the corners of Hwy 89 &amp; Donner Pass Rd to stand up for our democracy and remind everyone to vote early. A peaceful gathering: share the sidewalks, stay off the street, and support local businesses. Brought to you with our friends at Elders Action Network and Citizens&rsquo; Climate Lobby North Tahoe.</p>
          <div class="flex flex-col sm:flex-row gap-3">
            <a href="https://www.mobilize.us/mobilize/event/1032152/" target="_blank" rel="noopener" class="btn-red text-sm inline-block">Register on Mobilize &rarr;</a>
            <a href="https://maps.google.com/?q=Hwy+89+and+Donner+Pass+Rd,+Truckee,+CA" target="_blank" rel="noopener" class="btn-primary text-sm inline-block">Get Directions &rarr;</a>
          </div>
        </div>
      </div>

      <!-- October 21 — Ballot Review -->
      <div class="card border border-white/10">
        <div class="flex items-center gap-3 mb-3 flex-wrap">
          <span class="bg-sky text-white text-xs font-black uppercase tracking-widest px-3 py-1 rounded-full">Upcoming</span>
          <span class="text-slate-400 text-sm font-semibold">Wednesday, October 21, 2026</span>
        </div>
        <h2 class="text-white font-black text-2xl mb-1">Ballot Review</h2>
        <p class="text-sky-bright font-bold mb-4">6:00pm &nbsp;·&nbsp; Raley&rsquo;s, Truckee</p>
        <p class="text-slate-300 text-sm leading-relaxed mb-5">Got your ballot? Let&rsquo;s go through it together. We&rsquo;ll walk through what&rsquo;s on the ballot so you can vote with confidence. Bring questions, bring a friend.</p>
        <div class="flex flex-col sm:flex-row gap-3">
          <a href="https://www.mobilize.us/mobilize/event/1063332/" target="_blank" rel="noopener" class="btn-red text-sm inline-block">Register on Mobilize &rarr;</a>
          <a href="https://maps.google.com/?q=Raley%27s,+11399+Deerfield+Dr,+Truckee,+CA+96161" target="_blank" rel="noopener" class="btn-primary text-sm inline-block">Get Directions &rarr;</a>
        </div>
      </div>

      <!-- Saturday, October 24, 2026 — Paws to the Polls: Tahoe City -->
      <div class="card flex flex-col md:flex-row gap-8 items-start">
        <a href="https://www.mobilize.us/mobilize/event/1063346/" target="_blank" rel="noopener" class="w-full md:w-56 shrink-0">
          <img
            src="/images/paws-to-the-polls-tahoe-city.png"
            alt="Paws to the Polls flyer — October 24, 10am, Tahoe City. Start at Old Safeway, 850 N Lake Tahoe Blvd"
            class="w-full rounded-xl object-cover hover:opacity-90 transition-opacity"
          />
        </a>
        <div class="flex-1">
          <div class="flex items-center gap-3 mb-3 flex-wrap">
            <span class="bg-sky text-white text-xs font-black uppercase tracking-widest px-3 py-1 rounded-full">Upcoming</span>
            <span class="text-slate-400 text-sm font-semibold">Saturday, October 24, 2026</span>
          </div>
          <h2 class="text-white font-black text-2xl mb-1">Paws to the Polls: Tahoe City</h2>
          <p class="text-sky-bright font-bold mb-4">10:00am &nbsp;·&nbsp; Tahoe City, CA</p>
          <p class="text-slate-300 text-sm leading-relaxed mb-4">Exercise your dog and your right to vote! A parade of people and pups (costumes optional!) to the polls at the end of town.</p>
          <div class="bg-navy rounded-lg px-4 py-3 text-sm space-y-2 mb-5">
            <div class="flex gap-3">
              <span class="text-sky-bright font-bold shrink-0">Start</span>
              <p class="text-slate-300"><span class="text-white font-semibold">Old Safeway</span>, 850 N Lake Tahoe Blvd, Tahoe City</p>
            </div>
            <div class="flex gap-3">
              <span class="text-sky-bright font-bold shrink-0">Parade</span>
              <p class="text-slate-300">People and pups to the polls at the end of town</p>
            </div>
          </div>
          <div class="flex flex-col sm:flex-row gap-3">
            <a href="https://www.mobilize.us/mobilize/event/1063346/" target="_blank" rel="noopener" class="btn-red text-sm inline-block">Register on Mobilize &rarr;</a>
            <a href="https://maps.google.com/?q=850+N+Lake+Tahoe+Blvd,+Tahoe+City,+CA+96145" target="_blank" rel="noopener" class="btn-primary text-sm inline-block">Get Directions &rarr;</a>
          </div>
        </div>
      </div>

      <!-- Sunday, October 25, 2026 — Paws to the Polls: Truckee -->
      <div class="card flex flex-col md:flex-row gap-8 items-start">
        <a href="https://www.mobilize.us/mobilize/event/1065521/" target="_blank" rel="noopener" class="w-full md:w-56 shrink-0">
          <img
            src="/images/paws-to-the-polls-truckee.png"
            alt="Paws to the Polls flyer — 10am, Truckee. Start at Meadow Park, 10115 Donner Trail Rd, parade to the Truckee Library"
            class="w-full rounded-xl object-cover hover:opacity-90 transition-opacity"
          />
        </a>
        <div class="flex-1">
          <div class="flex items-center gap-3 mb-3 flex-wrap">
            <span class="bg-sky text-white text-xs font-black uppercase tracking-widest px-3 py-1 rounded-full">Upcoming</span>
            <span class="text-slate-400 text-sm font-semibold">Sunday, October 25, 2026</span>
          </div>
          <h2 class="text-white font-black text-2xl mb-1">Paws to the Polls: Truckee</h2>
          <p class="text-sky-bright font-bold mb-4">10:00am &nbsp;·&nbsp; Truckee, CA</p>
          <p class="text-slate-300 text-sm leading-relaxed mb-4">Exercise your dog and your right to vote! Bring your completed Nevada County ballot ready for the drop box. Voting in Placer County? Join the Tahoe City parade on Saturday, October 24.</p>
          <div class="bg-navy rounded-lg px-4 py-3 text-sm space-y-2 mb-5">
            <div class="flex gap-3">
              <span class="text-sky-bright font-bold shrink-0">Start</span>
              <p class="text-slate-300"><span class="text-white font-semibold">Meadow Park</span>, 10115 Donner Trail Rd, Truckee</p>
            </div>
            <div class="flex gap-3">
              <span class="text-sky-bright font-bold shrink-0">Parade</span>
              <p class="text-slate-300">People and pups to the <span class="text-white font-semibold">Truckee Library</span>, 10031 Levon Ave</p>
            </div>
          </div>
          <div class="flex flex-col sm:flex-row gap-3">
            <a href="https://www.mobilize.us/mobilize/event/1065521/" target="_blank" rel="noopener" class="btn-red text-sm inline-block">Register on Mobilize &rarr;</a>
            <a href="https://maps.google.com/?q=10115+Donner+Trail+Rd,+Truckee,+CA+96161" target="_blank" rel="noopener" class="btn-primary text-sm inline-block">Get Directions &rarr;</a>
          </div>
        </div>
      </div>

      <!-- Sunday, October 25, 2026 — Bike to the Ballot Box -->
      <div class="card flex flex-col md:flex-row gap-8 items-start">
        <a href="https://www.mobilize.us/mobilize/event/1065526/" target="_blank" rel="noopener" class="w-full md:w-56 shrink-0">
          <img
            src="/images/bike-to-the-ballot-box-truckee.png"
            alt="Bike to the Ballot Box flyer — Sunday October 25, Truckee. Start at Truckee River Regional Park, ride the Legacy Trail to Truckee Airport"
            class="w-full rounded-xl object-cover hover:opacity-90 transition-opacity"
          />
        </a>
        <div class="flex-1">
          <div class="flex items-center gap-3 mb-3 flex-wrap">
            <span class="bg-sky text-white text-xs font-black uppercase tracking-widest px-3 py-1 rounded-full">Upcoming</span>
            <span class="text-slate-400 text-sm font-semibold">Sunday, October 25, 2026</span>
          </div>
          <h2 class="text-white font-black text-2xl mb-1">Bike to the Ballot Box</h2>
          <p class="text-sky-bright font-bold mb-4">Meet 9:30am &nbsp;·&nbsp; Depart 10:00am sharp &nbsp;·&nbsp; Truckee, CA</p>
          <p class="text-slate-300 text-sm leading-relaxed mb-4">A bike parade (costumes optional!) along the Legacy Trail to the ballot boxes at Truckee Airport. Completed Nevada County or Placer County ballots can go right into the drop boxes, and Nevada County voters can vote early on site in the Truckee Airport Community Room. Riders disperse after arrival: head into the polls, extend your ride, or head back at your own pace.</p>
          <div class="bg-navy rounded-lg px-4 py-3 text-sm space-y-2 mb-5">
            <div class="flex gap-3">
              <span class="text-sky-bright font-bold shrink-0">9:30am</span>
              <p class="text-slate-300">Meet at <span class="text-white font-semibold">Truckee River Regional Park</span>, 10500 Brockway Rd</p>
            </div>
            <div class="flex gap-3">
              <span class="text-sky-bright font-bold shrink-0">10:00am</span>
              <p class="text-slate-300">Depart sharp, ride the Legacy Trail to <span class="text-white font-semibold">Truckee Airport</span></p>
            </div>
          </div>
          <div class="flex flex-col sm:flex-row gap-3">
            <a href="https://www.mobilize.us/mobilize/event/1065526/" target="_blank" rel="noopener" class="btn-red text-sm inline-block">Register on Mobilize &rarr;</a>
            <a href="https://maps.google.com/?q=10500+Brockway+Rd,+Truckee,+CA+96161" target="_blank" rel="noopener" class="btn-primary text-sm inline-block">Get Directions &rarr;</a>
          </div>
        </div>
      </div>

    </div>
  </section>

  <!-- Stay in the loop -->
  <section class="bg-navy py-16">
    <div class="max-w-5xl mx-auto px-6 text-center">
      <p class="text-slate-400 text-sm mb-2">Want to be notified about future events?</p>
      <a href="/#join" class="text-sky font-bold hover:underline">Sign up for our list &rarr;</a>
    </div>
  </section>

  <!-- Footer -->
  <footer class="bg-navy-deep border-t border-white/10 py-10">
    <div class="max-w-5xl mx-auto px-6 flex flex-col md:flex-row items-center justify-between gap-4">
      <div>
        <p class="text-white font-black uppercase tracking-wide">Indivisible Tahoe Truckee</p>
        <p class="text-slate-500 text-xs mt-1">Part of the national Indivisible movement.</p>
      </div>
      <div class="flex gap-6 text-sm text-slate-400">
        <a href="https://forestservice.indivisibletahoetruckee.org" class="hover:text-white transition-colors">Forest Service Campaign</a>
        <a href="https://www.facebook.com/groups/1169555336469226/" target="_blank" rel="noopener" class="hover:text-white transition-colors">Facebook</a>
        <a href="mailto:indivisibletahoetruckee@gmail.com" class="hover:text-white transition-colors">indivisibletahoetruckee@gmail.com</a>
        <a href="https://indivisible.org" target="_blank" rel="noopener" class="hover:text-white transition-colors">Indivisible National</a>
      </div>
    </div>
  </footer>

</Layout>
