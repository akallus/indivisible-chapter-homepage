---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Events" description="Upcoming Indivisible Tahoe Truckee events — community actions, marches, and ways to show up.">

  <!-- Nav -->
  <nav class="bg-navy-deep border-b border-white/10 sticky top-0 z-50">
    <div class="max-w-5xl mx-auto px-6 flex items-center justify-between h-16">
      <a href="/" class="flex flex-col leading-none">
        <span class="text-xs font-bold uppercase tracking-widest text-sky-bright">Tahoe Truckee</span>
        <span class="text-white font-black text-base tracking-wide uppercase">Indivisible</span>
      </a>
      <div class="flex items-center gap-6">
        <a href="https://forestservice.indivisibletahoetruckee.org" class="hidden md:block text-sm font-semibold text-slate-300 hover:text-white transition-colors">Forest Service Campaign</a>
        <a href="/events" class="hidden md:block text-sm font-semibold text-white transition-colors">Events</a>
        <a href="/#join" class="bg-sky text-white text-sm font-bold px-5 py-2 rounded-lg hover:opacity-90 transition-opacity">Join Us</a>
      </div>
    </div>
  </nav>

  <!-- Hero -->
  <section class="bg-navy py-20">
    <div class="max-w-5xl mx-auto px-6">
      <p class="section-label">Get Involved</p>
      <h1 class="text-5xl md:text-7xl font-black leading-none tracking-tight text-white mb-6">Upcoming<br />Events</h1>
      <div class="blue-rule"></div>
      <p class="text-xl text-slate-300 max-w-2xl leading-relaxed mt-6">Show up. Every person who comes out makes our voice louder.</p>
    </div>
  </section>

  <!-- Events List -->
  <section class="bg-navy-mid py-16">
    <div class="max-w-5xl mx-auto px-6 space-y-8">

      <!-- Justice for Lorenzo and Johan -->
      <div class="card flex flex-col md:flex-row gap-8 items-start">
        <img
          src="/images/justice-for-lorenzo-and-johan-truckee.png"
          alt="Justice for Lorenzo and Johan — Justice for All, ICE Out. Community march flyer with photos of Lorenzo and Johan surrounded by flowers."
          class="w-full md:w-72 rounded-xl object-cover shrink-0"
        />
        <div class="flex-1">
          <div class="flex items-center gap-3 mb-3 flex-wrap">
            <span class="bg-sky text-white text-xs font-black uppercase tracking-widest px-3 py-1 rounded-full">Upcoming</span>
            <span class="text-slate-400 text-sm font-semibold">Saturday, July 25, 2026</span>
          </div>
          <h2 class="text-white font-black text-2xl md:text-3xl mb-1">Justice for Lorenzo and Johan</h2>
          <p class="text-sky-bright font-bold mb-5">12:00pm – 1:00pm PDT &nbsp;·&nbsp; Truckee, CA</p>

          <p class="text-slate-300 text-sm leading-relaxed mb-5">
            A community march in solidarity with Lorenzo and Johan and all those affected by ICE enforcement in our region. We gather at Church of the Mountains at noon, then walk together to the Eagle Statue, arriving by 12:30pm. Come as you are. Bring a neighbor.
          </p>

          <div class="bg-navy rounded-lg px-5 py-4 text-sm space-y-2 mb-6">
            <div class="flex gap-3">
              <span class="text-sky-bright shrink-0 font-bold">12:00pm</span>
              <p class="text-slate-300">Gather at <span class="text-white font-semibold">Church of the Mountains</span>, 10079 Church St, Truckee, CA 96161</p>
            </div>
            <div class="flex gap-3">
              <span class="text-sky-bright shrink-0 font-bold">12:30pm</span>
              <p class="text-slate-300">Processional arrives at <span class="text-white font-semibold">Eagle Statue</span></p>
            </div>
          </div>

          <a
            href="https://maps.google.com/?q=10079+Church+St,+Truckee,+CA+96161"
            target="_blank"
            rel="noopener"
            class="btn-primary text-sm inline-block"
          >Get Directions &rarr;</a>
        </div>
      </div>

    </div>
  </section>

  <!-- Stay in the loop -->
  <section class="bg-navy py-16">
    <div class="max-w-5xl mx-auto px-6 text-center">
      <p class="text-slate-400 text-sm mb-2">Want to be notified about future events?</p>
      <a href="/#join" class="text-sky font-bold hover:underline">Sign up for our list &rarr;</a>
    </div>
  </section>

  <!-- Footer -->
  <footer class="bg-navy-deep border-t border-white/10 py-10">
    <div class="max-w-5xl mx-auto px-6 flex flex-col md:flex-row items-center justify-between gap-4">
      <div>
        <p class="text-white font-black uppercase tracking-wide">Indivisible Tahoe Truckee</p>
        <p class="text-slate-500 text-xs mt-1">Part of the national Indivisible movement.</p>
      </div>
      <div class="flex gap-6 text-sm text-slate-400">
        <a href="https://forestservice.indivisibletahoetruckee.org" class="hover:text-white transition-colors">Forest Service Campaign</a>
        <a href="https://www.facebook.com/groups/1169555336469226/" target="_blank" rel="noopener" class="hover:text-white transition-colors">Facebook</a>
        <a href="mailto:IndivisibleTahoeTruckee@gmail.com" class="hover:text-white transition-colors">Contact</a>
        <a href="https://indivisible.org" target="_blank" rel="noopener" class="hover:text-white transition-colors">Indivisible National</a>
      </div>
    </div>
  </footer>

</Layout>
